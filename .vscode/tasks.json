{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "gradle bootRun -x test",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Tests",
      "type": "shell",
      "command": "gradle test",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Interview Test",
      "type": "shell",
      "command": "gradle test --tests '*PatientOverviewIntegrationTest*'",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Patient Service",
      "type": "shell",
      "command": ". .venv/bin/activate && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/patient-service"
      },
      "problemMatcher": []
    },
    {
      "label": "Reset Interview State",
      "type": "shell",
      "command": "./scripts/reset-interview-state.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}